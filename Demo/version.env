# FlipStack release version — single source of truth.
#
# Read by Scripts/bundle-demo.sh (and by the CI/release workflows). Bump these
# two values for a release; the bundle's Info.plist, the in-app version label
# and the DMG are all derived from them.
#
# Keep the format shell-compatible: KEY=value, no spaces around "=".

MARKETING_VERSION=1.0.3
BUILD_NUMBER=14
